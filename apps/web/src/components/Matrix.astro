---
import { agents, capabilities, getAgent, sitePath, testSlug } from "../data";

const { ids = agents.map((agent) => agent.id), filterable = false } =
  Astro.props;
const selected = ids.map((id: string) => getAgent(id)!);
---
<div class="table-wrap"><table data-comparison={filterable || undefined}><caption>Observed results and official documentation are separate evidence. Missing data remains unknown.</caption><thead><tr><th scope="col">Capability</th>{selected.map(agent => <th scope="col" data-agent={agent.id}><a href={sitePath(`/agents/${agent.id}`)}>{agent.name}</a></th>)}</tr></thead><tbody>{capabilities.map(capability => <tr data-category={capability.category}><th scope="row"><a href={sitePath(`/capabilities/${testSlug(capability.id)}`)}>{capability.title}</a></th>{selected.map(agent => { const cell = agent.capabilities[capability.id]; const observed = cell.completed[0]; const attempt = cell.observations[0]; return <td data-agent={agent.id}>{observed ? <a class={`badge ${observed.result.status}`} href={sitePath(`/runs/${observed.runId}`)}>{observed.result.status === "pass" ? "✓ OBSERVED" : "× FAILED"}</a> : <span class="badge">? UNKNOWN</span>}{observed && <span class="cell-note">v{observed.agent.version} · {observed.environment.os} {observed.environment.arch}</span>}{attempt && attempt.result.status !== "pass" && attempt.result.status !== "fail" && <span class="cell-note"><a href={sitePath(`/runs/${attempt.runId}`)}>Latest attempt: {attempt.result.status}</a></span>}<span class="cell-note">{cell.claims.length ? <a href={cell.claims[0].source.url}>Documented: {cell.documented === "documented" ? "yes" : cell.documented} ↗</a> : "Documented: unknown"}</span></td>; })}</tr>)}</tbody></table></div><div class="legend"><span>✓ Observed in a completed run</span><span>× Expected behavior not observed</span><span>? Insufficient evidence</span><a href={sitePath('/methodology')}>How to read these results →</a></div>
