---
import Matrix from "../../components/Matrix.astro";
import { agents, getAgent, sitePath } from "../../data";
import Layout from "../../layouts/Layout.astro";
export const getStaticPaths = () =>
  agents.map((agent) => ({ params: { agent: agent.id } }));
const agent = getAgent(Astro.params.agent!)!;
const counts = Object.values(agent.capabilities).reduce(
  (out, cap) => {
    out[cap.observed] = (out[cap.observed] || 0) + 1;
    return out;
  },
  {} as Record<string, number>,
);
---
<Layout title={agent.name}><div class="eyebrow">{agent.vendor} / agent</div><h1>{agent.name}</h1><p><a href={agent.documentation}>Official documentation ↗</a></p><div class="stats"><div><strong>{agent.latest[0]?.agent.version || "Not tested"}</strong><span>Most recently tested version</span></div><div><strong>{counts.pass || 0}</strong><span>Capabilities observed</span></div><div><strong>{counts.fail || 0}</strong><span>Latest completed observations failed</span></div><div><strong>{counts.unknown || 0}</strong><span>Unknown</span></div><div><strong>{Object.values(agent.capabilities).flatMap(c => c.claims).length}</strong><span>Documentation claims</span></div></div><p class="muted">Environments: {[...new Set(agent.history.map(r => `${r.environment.os} ${r.environment.arch} (${r.environment.osVersion})`))].join(", ") || "None recorded"}. Capability summaries may refer to different versions. Inspect each run for context.</p><Matrix ids={[agent.id]} /><h2 class="section">Run history</h2>{agent.history.length ? <div class="table-wrap"><table><thead><tr><th>Test / evidence</th><th>Agent version</th><th>Test version</th><th>Environment</th><th>Result</th><th>Date</th></tr></thead><tbody>{[...agent.history].sort((a,b) => b.execution.startedAt.localeCompare(a.execution.startedAt)).map(run => <tr><td><a href={sitePath(`/runs/${run.runId}`)}>{run.test.id}</a></td><td>{run.agent.version}</td><td>{run.test.version}</td><td>{run.environment.os} {run.environment.arch}</td><td><span class={`badge ${run.result.status}`}>{run.result.status}</span></td><td>{run.execution.startedAt.slice(0,10)}</td></tr>)}</tbody></table></div> : <p class="empty">No runs yet. <a href={sitePath('/contribute')}>Contribute the first observation.</a></p>}{agent.authors.length > 0 && <p>Adapter maintained by {agent.authors.map(a => <a href={`https://github.com/${a.github}`}>@{a.github} </a>)}</p>}</Layout>
