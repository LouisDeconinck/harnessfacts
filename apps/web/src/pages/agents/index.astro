---
import { agents, getAgent, sitePath } from "../../data";
import Layout from "../../layouts/Layout.astro";
---
<Layout title="Agents"><div class="eyebrow">The adapter registry</div><h1>Meet the agents.</h1><p class="muted">Adapters describe how to run a product. Results record what happened. No run means unknown, not unsupported.</p><div class="cards">{agents.map(agent => { const summary = getAgent(agent.id)!; const verified = summary.history.some(r => r.result.status === "pass" || r.result.status === "fail"); return <a class="card" href={sitePath(`/agents/${agent.id}`)}><span class="num">{agent.vendor} · {verified ? "RUNTIME VERIFIED" : "UNVERIFIED"}</span><h2>{agent.name}</h2><p>{summary.history.length} recorded runs · {agent.invocation.kind} adapter</p>Inspect capabilities →</a>})}</div></Layout>
