---
import { results, runPath, sitePath, testSlug } from "../../data";
import Layout from "../../layouts/Layout.astro";
export const getStaticPaths = () =>
  results.map((run) => ({ params: { run: run.runId }, props: { run } }));
const { run } = Astro.props;
const path = runPath(run);
---
<Layout title={`${run.agent.id} · ${run.test.id} · ${run.result.status}`}><div class="eyebrow">Run evidence / {run.provenance.kind}</div><h1>{run.result.status.toUpperCase()}</h1><p>{run.result.summary}</p><p><a href={sitePath(`/agents/${run.agent.id}`)}>{run.agent.id}</a> v{run.agent.version} × <a href={sitePath(`/tests/${testSlug(run.test.id)}`)}>{run.test.id}</a> v{run.test.version}</p><div class="prose"><dl><dt>Environment</dt><dd>{run.environment.os} {run.environment.osVersion} · {run.environment.arch} · Bun {run.environment.runtime.bun}</dd><dt>Started</dt><dd>{run.execution.startedAt}</dd><dt>Duration / exit code</dt><dd>{Math.round(run.execution.durationMs)} ms / {String(run.execution.exitCode)}</dd><dt>Provenance</dt><dd>{run.provenance.kind}{run.provenance.contributor ? ` · ${run.provenance.contributor}` : ""} · self-reported, not a signed attestation</dd></dl><div class="actions"><a class="button" href={`${path}.json`}>Download run JSON</a><a class="button secondary" href={`${path}/stdout.txt`}>Read stdout</a><a class="button secondary" href={`${path}/stderr.txt`}>Read stderr</a></div><h2 class="section">Evidence hashes</h2><p>SHA-256 hashes refer to the saved, redacted evidence bytes.</p><h3>stdout</h3><pre>{run.evidence.stdoutSha256}</pre><h3>stderr</h3><pre>{run.evidence.stderrSha256}</pre>{run.evidence.artifacts.map(artifact => <div><h3><a href={`${path}/artifacts/${artifact.path}`}>{artifact.path} ↗</a></h3><pre>{artifact.sha256}</pre></div>)}<details><summary>Complete result record</summary><pre>{JSON.stringify(run,null,2)}</pre></details><p><a href={sitePath('/methodology')}>What this observation means — and its limits →</a></p></div></Layout>
