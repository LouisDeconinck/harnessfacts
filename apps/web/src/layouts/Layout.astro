---
import { sitePath } from "../data";

const {
  title = "Tested facts about AI coding agents",
  description = "Reproducible compatibility tests. Inspect the evidence, understand the limits, contribute a result.",
} = Astro.props;
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>{title} · HarnessFacts</title><meta name="description" content={description} /><link rel="icon" href={sitePath('/favicon.svg')} type="image/svg+xml" /></head>
<body><a class="skip" href="#main">Skip to content</a><header><a href={sitePath('/')} class="brand"><span class="mark" aria-hidden="true">[h/f]</span> HarnessFacts</a><nav aria-label="Main navigation"><a href={sitePath('/agents')}>Agents</a><a href={sitePath('/tests')}>Tests</a><a href={sitePath('/compare')}>Compare</a><a href={sitePath('/methodology')}>Methodology</a><a class="nav-cta" href={sitePath('/contribute')}>Contribute ↗</a></nav></header>
<main id="main"><slot /></main><footer><a href={sitePath('/')} class="brand">[h/f] HarnessFacts</a><p>Evidence over assumptions. No rankings. No synthetic scores.</p><a href="https://github.com/LouisDeconinck/harnessfacts">Source &amp; Apache-2.0 license ↗</a></footer></body></html>
<style is:global>
:root{font-family:Inter,ui-sans-serif,system-ui,sans-serif;color:#182c26;background:#f6f5ef;font-synthesis:none;--green:#174f3b;--muted:#5d6961;--line:#d8ded4}*{box-sizing:border-box}body{margin:0}a{color:inherit;text-underline-offset:4px}a:hover{color:#246c49}button,input,select{font:inherit}button,a,input,select{outline-offset:5px}:focus-visible{outline:3px solid #dc6c39}header,main,footer{max-width:1360px;margin:auto;padding-left:48px;padding-right:48px}header{display:flex;align-items:center;justify-content:space-between;min-height:100px;border-bottom:1px solid var(--line);gap:20px}.brand{font-weight:750;font-size:20px;text-decoration:none;letter-spacing:-.7px}.mark{font-family:monospace;font-size:24px;color:var(--green);margin-right:9px}nav{display:flex;align-items:center;gap:26px;font-size:14px}nav a{text-decoration:none}.nav-cta{border:1px solid var(--line);padding:10px 16px;border-radius:5px}main{min-height:70vh;padding-top:48px;padding-bottom:80px}h1{font-size:clamp(38px,5.2vw,72px);line-height:1.06;letter-spacing:-3px;font-weight:650;margin:18px 0 24px;max-width:850px}h2{font-size:27px;letter-spacing:-.8px;margin:0 0 20px}h3{font-size:19px;letter-spacing:-.3px}p{line-height:1.7}.muted{color:var(--muted)}.eyebrow{font-family:ui-monospace,monospace;text-transform:uppercase;font-size:12px;letter-spacing:1.5px;color:var(--green);display:flex;gap:10px;align-items:center}.dot{width:7px;height:7px;background:#41754f;border-radius:50%;display:inline-block}.hero{padding:18px 0 55px;display:grid;grid-template-columns:1.5fr 1fr;gap:60px;align-items:center}.hero p{font-size:18px;color:var(--muted);max-width:610px}.accent{color:var(--green)}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:28px}.button{display:inline-block;padding:13px 19px;border:1px solid var(--green);border-radius:5px;text-decoration:none;font-weight:600;font-size:14px;background:var(--green);color:white}.button:hover{background:#246344;color:white}.button.secondary{background:transparent;color:var(--green)}.terminal{background:#182c26;color:#dce6d9;border-radius:8px;padding:24px;box-shadow:9px 12px 0 #e2e6db;font:13px/1.9 ui-monospace,monospace;overflow:auto}.terminal .bar{border-bottom:1px solid #3b4c43;padding-bottom:13px;margin-bottom:20px;color:#aebfae}.terminal code{background:none;color:inherit}.terminal .success{color:#aad0a1}.terminal .dim{color:#a9b5ad}.section{margin-top:38px}.section-head{display:flex;justify-content:space-between;gap:20px;align-items:baseline;margin-bottom:20px}.section-head h2{margin:0}.section-head p{margin:0;font-size:13px;color:var(--muted)}.table-wrap{overflow:auto;border:1px solid var(--line);border-radius:7px;background:#fffefa}table{width:100%;border-collapse:collapse;font-size:14px;white-space:normal}caption{text-align:left;padding:16px;color:var(--muted);font-size:12px}th,td{text-align:left;padding:17px 20px;border-bottom:1px solid var(--line);vertical-align:top}thead th{font-size:12px;font-weight:600;color:var(--muted);background:#eef0e8;white-space:nowrap}tbody tr:last-child>*{border-bottom:0}tbody th{min-width:180px;font-weight:550}tbody th a{text-decoration:none}td{min-width:140px}.badge{display:inline-flex;align-items:center;gap:5px;font:11px ui-monospace,monospace;letter-spacing:.5px;border:1px solid var(--line);background:#edf0e9;color:#59675c;border-radius:4px;padding:5px 7px;text-decoration:none}.badge.pass{background:#e3eee0;color:#24512c;border-color:#c8ddbf}.badge.fail{background:#fbe8de;color:#913d23;border-color:#edc4b0}.badge.error{background:#fff0ce;color:#755220;border-color:#dfcc9f}.cell-note{display:block;font-size:10px;line-height:1.6;color:var(--muted);margin-top:7px}.cell-note a{color:var(--green)}.legend{display:flex;gap:22px;flex-wrap:wrap;color:var(--muted);font-size:12px;padding:15px 0}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:30px}.card{border:1px solid var(--line);border-radius:7px;padding:24px;background:#fffefa;text-decoration:none}.card p{font-size:14px;color:var(--muted)}.card .num{font:12px monospace;color:var(--green)}.prose{max-width:790px}.prose h2{margin-top:40px}.prose li{line-height:1.8;margin-bottom:7px}pre{overflow:auto;background:#e9ece3;border:1px solid var(--line);padding:20px;border-radius:5px;font-size:12px;line-height:1.7}code{font-family:ui-monospace,monospace;font-size:.9em;overflow-wrap:anywhere}.stats{display:flex;gap:40px;flex-wrap:wrap;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:22px 0;margin:35px 0}.stats strong{display:block;font-size:28px;font-weight:600}.stats span{font-size:12px;color:var(--muted)}.filters{display:flex;gap:18px;flex-wrap:wrap;margin:25px 0;align-items:center}fieldset{border:1px solid var(--line);border-radius:5px;padding:18px}fieldset label{display:inline-flex;align-items:center;gap:7px;margin:6px 20px 6px 0;font-size:14px}select{padding:9px;background:white;border:1px solid var(--line);border-radius:4px}.empty{padding:30px;border:1px dashed var(--line);color:var(--muted)}details{margin:20px 0}summary{cursor:pointer;font-weight:600}footer{border-top:1px solid var(--line);padding-top:30px;padding-bottom:40px;display:flex;gap:30px;align-items:center;justify-content:space-between;font-size:12px;color:var(--muted)}footer .brand{font-size:14px}footer p{font-size:12px}.skip{position:absolute;top:-100px;background:white;padding:15px;z-index:10}.skip:focus{top:0}[hidden]{display:none!important}@media(max-width:800px){header,main,footer{padding-left:22px;padding-right:22px}header{flex-wrap:wrap;padding-top:23px;padding-bottom:20px}nav{gap:17px;flex-wrap:wrap;font-size:12px}.hero{grid-template-columns:1fr;gap:28px;padding-top:0}h1{letter-spacing:-1.7px}.cards{grid-template-columns:1fr}.section-head{display:block}.section-head p{margin-top:10px}.stats{gap:25px}footer{flex-direction:column;align-items:flex-start;gap:8px}th,td{padding:13px}.terminal{font-size:12px}}
</style>
