{
  "name": "harnessfacts-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "hf": "bun packages/cli/src/index.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test checks",
    "validate": "bun packages/cli/src/index.ts validate",
    "build": "bun scripts/build.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@types/bun": "1.3.10",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "zod": "4.3.6"
  }
}
